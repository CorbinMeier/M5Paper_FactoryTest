{
    "name": "m5paper-ui",
    "version": "0.1.0",
    "description": "Component library, device wrapper and application framework for the M5Paper (ESP32-D0WDQ6-V3 + 4.7\" 540x960 e-ink panel).",
    "keywords": ["m5paper", "m5stack", "epaper", "eink", "esp32", "gui"],
    "license": "MIT",
    "frameworks": "arduino",
    "platforms": "espressif32",
    "headers": "m5paper_ui.h",
    "dependencies": [
        {
            "owner": "m5stack",
            "name": "M5EPD",
            "version": "^0.1.3"
        }
    ],
    "build": {
        "srcFilter": ["+<*>"],
        "flags": ["-ffunction-sections", "-fdata-sections"]
    }
}
